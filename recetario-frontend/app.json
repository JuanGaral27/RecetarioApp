{
  "expo": {
    "name": "Recetario",
    "slug": "recetario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jdgaral27.recetario"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0922B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.jdgaral27.recetario"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Recetario acceda a tus fotos para elegir imágenes de recetas y de tu perfil."
        }
      ]
    ]
  }
}